# Jarvis-Glas — Umgebungsvariablen (Beispiel)
# Kopiere diese Datei zu `.env` und passe Werte an. Nie Secrets in das Repo committen.

# --- API-Keys (serverseitig, nie im Frontend) ---
XAI_API_KEY=dein_xai_key_hier
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
FISH_AUDIO_API_KEY=

# --- Signing (Tauri OTA-Updates) ---
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- Sicherheit / Datenschutz ---
# Erlaubt Server-.env-Fallback im Release-Build (default: false im Build).
# Lokaler Dev kann true setzen, um eigene .env Vorrang zu geben.
HHQ_ALLOW_ENV_FALLBACK=false

# LifeOS-Kontext an Cloud-Modelle (xAI) senden.
# default: true  -> LifeOS (MISSION/VALUES/CURRENT_STATE) wird wie bisher an xAI gesendet
#                  (Erhält Jarvis' Persönlichkeit/Intelligenz im Cloud-Modus).
# false          -> LifeOS wird NICHT an externe Modelle gesendet (nur lokales Modell
#                  qwen/ollama bekommt es). Erhöht Datenschutz, reduziert aber
#                  Cloud-Intelligenz um den LifeOS-Kontext.
HHQ_CLOUD_LIFEOS_CONSENT=true
