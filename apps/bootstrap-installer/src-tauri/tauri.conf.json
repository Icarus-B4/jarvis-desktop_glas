{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis-Glas Setup",
  "version": "0.1.0",
  "identifier": "com.jarvis.desktop.setup",
  "build": {
    "beforeDevCommand": "cd .. && bun --hot",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jarvis-Glas Setup",
        "width": 720,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/install.ps1": "install.ps1",
      "resources/win-unpacked": "win-unpacked"
    },
    "category": "DeveloperTool",
    "shortDescription": "Jarvis-Glas Desktop Installer",
    "longDescription": "Installs Jarvis-Glas Desktop — the private control room assistant shell.",
    "publisher": "Jarvis-Glas",
    "copyright": "Copyright © 2026 Jarvis-Glas",
    "icon": [
      "../../../icons/32x32.png",
      "../../../icons/128x128.png",
      "../../../icons/128x128@2x.png",
      "../../../icons/icon.icns",
      "../../../icons/icon.ico"
    ],
    "windows": {
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
