{
  "name": "@jarvis/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "start": "bun run build && electron .",
    "preview": "electron .",
    "dist:win": "bun run build && electron-builder --win --config"
  },
  "build": {
    "appId": "org.jarvis.desktop",
    "productName": "Jarvis-Glas",
    "copyright": "Copyright © 2026 Jarvis-Glas",
    "icon": "icons/icon.ico",
    "files": [
      "dist/**/*",
      "icons/**/*",
      "backend/**/*",
      "scripts/**/*",
      "!**/.env",
      "!**/.env.*"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist",
        "filter": ["**/*", "!**/.env", "!**/.env.*"]
      },
      {
        "from": "tools/bun",
        "to": "bun"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "icons/icon.ico",
      "artifactName": "JARVIS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Icarus-B4",
      "repo": "jarvis-desktop_glas"
    }
  },
  "dependencies": {
    "@jarvis/shared": "workspace:*",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "electron-updater": "^6.3.9",
    "postprocessing": "6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "electron": "^37.2.6",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
