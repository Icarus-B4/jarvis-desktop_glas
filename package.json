    "preview": "electron ."
  },
  "dependencies": {
    "@jarvis/shared": "workspace:*",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "postprocessing": "6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "electron": "^37.2.6",
    "typescript": "^5.6.3"
  }
}
